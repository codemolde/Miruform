{
  "name": "miruform",
  "version": "1.0.0",
  "description": "Miruform — Local-first reference studio, gesture trainer, and spaced repetition viewer for artists and animators",
  "keywords": [
    "miruform",
    "art",
    "drawing",
    "art-practice",
    "gesture-drawing",
    "figure-drawing",
    "reference-viewer",
    "spaced-repetition",
    "sm-2",
    "anki",
    "artist-tools",
    "notan",
    "electron",
    "local-first"
  ],
  "main": "electron-main.js",
  "author": "codemolde",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "electron": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codemolde.miruform",
    "productName": "Miruform",
    "icon": "assets/icon.png",
    "afterPack": "./scripts/after-pack.js",
    "afterAllArtifactBuild": "./scripts/after-all-artifact-build.js",
    "files": [
      "server.js",
      "electron-main.js",
      "preload.js",
      "child-preload.js",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
